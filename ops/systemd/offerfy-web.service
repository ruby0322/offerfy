[Unit]
Description=Offerfy Next.js (next start on 0.0.0.0:3200)
After=network-online.target offerfy-api.service
Wants=network-online.target
Wants=offerfy-api.service

[Service]
Type=simple
User=ruby0322
Group=baeir
WorkingDirectory=/home/ruby0322/offerfy/apps/frontend
Environment=BACKEND_INTERNAL_URL=http://127.0.0.1:8001
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/local/bin/npx next start --hostname 0.0.0.0 --port 3200
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
