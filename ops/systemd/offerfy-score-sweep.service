# systemd **user** unit — installs to ~/.config/systemd/user/, not /etc.
# Agent sessions on abbey have no passwordless sudo, and a user timer plus
# `loginctl enable-linger ruby0322` needs none. See docs/deploy.md.
#
# This job SPENDS MONEY (LLM scoring and prose on users' behalf, unattended,
# four times a day, three on Monday -- see the timer) against the production
# database. It SHIPS DISABLED: do not
# enable the timer until `python -m app.jobs.score_sweep --dry-run` has shown
# what a pass costs; see docs/deploy.md.
#
# It SENDS NOTHING. Offerfy emails nobody: the job writes `job_scores` rows the
# dashboard reads. There is no mail queue to check when this fails, and no
# message in flight to chase -- a failure means some rows went unscored. See
# app/jobs/score_sweep.py.
[Unit]
Description=Offerfy score sweep (score new postings, write prose for strong fits)
Documentation=file:///home/ruby0322/offerfy/docs/deploy.md

# No After=/Requires= on postgres: a user manager cannot order itself against
# system or docker units. A run that lands before Postgres is up fails, and
# OnFailure= records it.
OnFailure=offerfy-score-sweep-failure.service

[Service]
Type=oneshot
WorkingDirectory=/home/ruby0322/offerfy/apps/backend
EnvironmentFile=/home/ruby0322/offerfy/.env.production
Environment=PATH=/home/ruby0322/offerfy/apps/backend/.tools:/home/ruby0322/offerfy/apps/backend/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/home/ruby0322/offerfy/apps/backend/.venv/bin/python -m app.jobs.score_sweep

TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
