# Local dest / docker compose: copy this file to `.env` at the repo root.
# Abbey public API: copy to `.env.production` and point offerfy-api.service
# EnvironmentFile there. Do not commit either file.
# Do not share APP_ENV, GOOGLE_REDIRECT_URI, or AUTH_TOKEN_SECRET between them.
# Compose app containers ignore DATABASE_URL / S3_ENDPOINT here and use
# docker DNS (postgres, seaweedfs-s3) instead.

# Postgres (compose publishes this host port)
OFFERFY_POSTGRES_PASSWORD=offerfy-local-dev-change-me
OFFERFY_POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:offerfy-local-dev-change-me@127.0.0.1:5432/offerfy

# Object storage (SeaweedFS S3)
OFFERFY_S3_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=seaweed-access
S3_SECRET_KEY=seaweed-secret
S3_BUCKET=offerfy-private

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/v1/auth/google/callback
# .env.production: https://offerfy.cc/api/v1/auth/google/callback
AUTH_TOKEN_SECRET=change-me-auth
# Comma-separated Google emails that may use /admin. Empty = nobody.
ADMIN_EMAILS=

# LLM (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Native backend / frontend
# Guest hourly AI/export caps (10 chat / 20 export per hour) apply only when
# APP_ENV=production. Keep development in `.env`. Abbey public API sets
# production in `.env.production`.
APP_ENV=development
# Public uvicorn worker count (unit ExecStart uses 2; keep in sync if you change it).
UVICORN_WORKERS=2
BACKEND_INTERNAL_URL=http://127.0.0.1:8001
TYPST_PACKAGE_PATH=apps/backend/typst/packages
TYPST_FONT_PATHS=apps/backend/fonts
NEXT_PUBLIC_API_BASE_URL=/api
MAX_UPLOAD_MB=10

# Host-published ports. Frontend defaults to 3100 so it does not bind 3000.
OFFERFY_FRONTEND_PORT=3100
OFFERFY_BACKEND_PORT=8000
