# Python
.venv/
apps/backend/.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Env and secrets
.env
.env.*
!.env.example
*.pem
k8s/overlays/*/secret.yaml
!k8s/overlays/*/secret.yaml.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Vendored Typst packages (preview/basic-resume, preview/scienceicons) are committed.
# Runtime-prefetched Universe CV templates stay local.
apps/backend/typst/packages/preview/*
!apps/backend/typst/packages/preview/basic-resume/
!apps/backend/typst/packages/preview/basic-resume/**
!apps/backend/typst/packages/preview/scienceicons/
!apps/backend/typst/packages/preview/scienceicons/**
apps/backend/typst/packages/.universe-thumbs/

# Fonts (too large; document how to fetch)
apps/backend/fonts/*
!apps/backend/fonts/.gitkeep
!apps/backend/fonts/README.md

# Pitch deck (seed/TAM slides; loop source only)
docs/pitch/*.pdf

# Host-local ops runbook (abbey live state; do not commit)
docs/deploy.md

# Superpowers scratch
.superpowers/
