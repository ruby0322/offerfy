apiVersion: v1
kind: Secret
metadata:
  name: offerfy-secrets
type: Opaque
stringData:
  # Copy to secret.yaml (gitignored), replace placeholders, then apply before the overlay.
  # kubectl apply -f k8s/overlays/prod/secret.yaml -n offerfy-prod
  OFFERFY_POSTGRES_PASSWORD: "change-me-prod-postgres"
  DATABASE_URL: "postgresql+psycopg://postgres:change-me-prod-postgres@postgres:5432/offerfy"
  S3_ACCESS_KEY: "change-me-prod-s3-access"
  S3_SECRET_KEY: "change-me-prod-s3-secret"
  AUTH_TOKEN_SECRET: "change-me-prod-auth-token"
  GOOGLE_CLIENT_ID: "change-me-prod-google-client-id"
  GOOGLE_CLIENT_SECRET: "change-me-prod-google-client-secret"
  OPENAI_API_KEY: "change-me-prod-openai-api-key"
  OPENAI_BASE_URL: "https://api.openai.com/v1"
